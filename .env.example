# Copy to .env and replace all credentials before deployment.
COMPOSE_PROJECT_NAME=modbus

POSTGRES_DB=modbus
POSTGRES_USER=modbus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

INFLUXDB_ORG=modbus
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_STRONG_INFLUX_PASSWORD
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_INFLUX_TOKEN

# Collector runtime tuning
POLL_WORKERS=500
POLL_TIMEOUT=800ms
SCHEDULER_OUTPUT_BUFFER=10000
LATEST_CACHE_MAX_POINTS=1500000
WAL_SEGMENT_BYTES=67108864
MAX_WAL_BYTES=10737418240
ACK_RESERVE_BYTES=67108864

# Development broker only: current collector does not authenticate to MQTT yet.

MQTT_BROKER=tcp://mqtt:1883
MQTT_CLIENT_ID=modbus-collector
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=modbus/telemetry
INFLUXDB_URL=http://influxdb:8086
SINK_TIMEOUT=10s
DELIVERY_BATCH_SIZE=500
DELIVERY_POLL_INTERVAL=1s
DELIVERY_RETRY_INTERVAL=1s
METRICS_ADDR=:9090
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
CONFIG_IMPORT_ON_START=false
